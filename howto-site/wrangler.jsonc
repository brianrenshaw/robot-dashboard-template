// briandrenshaw.com: the front page goes to /how-to, which is the overview; /how-to/build is the
// guide. The whole of briandrenshaw.com and www.briandrenshaw.com comes here (before this, the
// front page pointed at the old registrar and showed an error). Other names under the domain
// (the dashboards) are separate and untouched. The account is taken from CLOUDFLARE_ACCOUNT_ID at
// deploy time, so it is not written in this public file.
{
  "name": "briandrenshaw-howto",
  "main": "dist/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "briandrenshaw.com/*", "zone_name": "briandrenshaw.com" },
    { "pattern": "www.briandrenshaw.com/*", "zone_name": "briandrenshaw.com" }
  ]
}
